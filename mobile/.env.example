# 웹(.env.local)과 같은 프로젝트의 같은 키다. Vite는 VITE_, Expo는 EXPO_PUBLIC_ 접두사만 번들에 넣는다.
#
# publishable 키(sb_publishable_...)는 앱 번들에 포함되는 공개 키다.
# 앱 번들은 뜯어볼 수 있으니 실제 접근 통제는 RLS가 한다.
#
# secret 키(sb_secret_...)는 절대 여기에 넣지 말 것 — RLS를 통째로 우회한다.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# 초대 링크에 쓸 웹 배포 주소. 비워두면 sharecalendar:// 딥링크로 떨어져
# 앱이 깔린 사람만 초대를 열 수 있다.
EXPO_PUBLIC_SITE_URL=https://your-web-app.example.com
