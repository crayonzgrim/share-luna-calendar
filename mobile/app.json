{
  "expo": {
    "name": "우리 달력",
    "slug": "share-calendar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sharecalendar",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crayonzgrim.sharecalendar"
    },
    "android": {
      "package": "com.crayonzgrim.sharecalendar",
      "adaptiveIcon": {
        "backgroundColor": "#FDFBF7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "일정에 사진을 첨부하려고 사진 보관함을 열어요",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "일정 사진을 갤러리에 저장하려고 해요",
          "granularPermissions": []
        }
      ],
      "./plugins/withLightTheme"
    ]
  }
}
