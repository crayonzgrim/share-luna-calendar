{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@db": [
        "./lib/supabase.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../src/lib/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "../src/lib/**/*.test.ts",
    "../src/lib/supabase.ts",
    "../src/lib/useAuth.ts",
    "../src/lib/useGroups.ts"
  ]
}
